# Google Gemini API key for the ProofOfWorkPay backend.
# Get one at https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Which model to use (default: gemini-3.5-flash-lite)
# Other options: gemini-3.1-flash-lite-preview, gemini-3.5-flash
GEMINI_MODEL=gemini-3.5-flash-lite

# Backend port
PORT=8787
